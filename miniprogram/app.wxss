page { background: #f6f7f2; color: #2f3e3a; font-size: 34rpx; }
.page { min-height: 100vh; box-sizing: border-box; padding: 32rpx; }
.tab-swipe-page { backface-visibility: hidden; transform: translateZ(0); transform-origin: center center; }
.card { background: #fff; border-radius: 26rpx; padding: 34rpx; margin-bottom: 26rpx; box-shadow: 0 8rpx 24rpx rgba(55, 75, 68, .06); }
.title { font-size: 50rpx; font-weight: 700; line-height: 1.25; letter-spacing: -.02em; }
.section-title { font-size: 38rpx; font-weight: 650; margin-bottom: 22rpx; }
.muted { color: #71807b; }
.primary-btn { background: #52796f !important; color: #fff !important; border-radius: 22rpx; font-size: 36rpx; min-height: 104rpx; display: flex; align-items: center; justify-content: center; transition: transform 140ms cubic-bezier(.2,.8,.2,1), background-color 160ms ease-out; }
.primary-btn::after, .secondary-btn::after { border: 0; }
.secondary-btn { background: #e7efe9 !important; color: #365f55 !important; border-radius: 22rpx; min-height: 96rpx; font-size: 34rpx; transition: transform 140ms cubic-bezier(.2,.8,.2,1), background-color 160ms ease-out; }
.primary-btn:active, .secondary-btn:active { transform: scale(.98); }
.loading, .empty { padding: 100rpx 20rpx; text-align: center; color: #64736d; font-size: 30rpx; line-height: 1.6; }
