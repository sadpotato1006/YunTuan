page { background: #f6f7f2; color: #2f3e3a; font-size: 32rpx; }
.page { min-height: 100vh; box-sizing: border-box; padding: 32rpx; }
.card { background: #fff; border-radius: 24rpx; padding: 32rpx; margin-bottom: 24rpx; box-shadow: 0 8rpx 24rpx rgba(55, 75, 68, .06); }
.title { font-size: 44rpx; font-weight: 700; line-height: 1.4; }
.section-title { font-size: 34rpx; font-weight: 600; margin-bottom: 20rpx; }
.muted { color: #71807b; }
.primary-btn { background: #52796f !important; color: #fff !important; border-radius: 20rpx; font-size: 34rpx; min-height: 96rpx; display: flex; align-items: center; justify-content: center; }
.primary-btn::after, .secondary-btn::after { border: 0; }
.secondary-btn { background: #e7efe9 !important; color: #365f55 !important; border-radius: 20rpx; min-height: 88rpx; font-size: 32rpx; }
.loading, .empty { padding: 100rpx 20rpx; text-align: center; color: #71807b; }
