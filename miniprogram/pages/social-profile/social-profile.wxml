<view class="page profile-page">
  <view class="title">我的社交名片</view>
  <text class="page-intro">只展示你主动填写的公开资料，不包含真实姓名、联系方式、位置和设备身份。</text>

  <view class="card form-card">
    <view class="section-title">头像</view>
    <view class="avatar-editor">
      <image wx:if="{{profile.avatarType === 'custom'}}" class="current-avatar" src="{{profile.avatarValue}}" mode="aspectFill" />
      <view wx:else class="current-avatar virtual-avatar" style="background: {{profile.avatarColor}}">{{profile.avatarValue}}</view>
      <button class="choose-avatar-btn" open-type="chooseAvatar" bindchooseavatar="chooseAvatar">选择微信头像</button>
    </view>
    <text class="field-tip">也可以使用虚拟形象</text>
    <view class="avatar-options">
      <view
        wx:for="{{virtualAvatars}}"
        wx:key="value"
        class="avatar-option {{profile.avatarType === 'virtual' && profile.avatarValue === item.value ? 'selected' : ''}}"
        style="background: {{item.color}}"
        data-index="{{index}}"
        bindtap="selectVirtualAvatar"
      >{{item.value}}</view>
    </view>
  </view>

  <view class="card form-card">
    <view class="field-block">
      <view class="field-header"><text>昵称</text><text>{{profile.nickname.length}}/16</text></view>
      <input class="text-input" type="nickname" maxlength="16" value="{{profile.nickname}}" placeholder="给自己取一个友好的昵称" bindinput="inputNickname" />
    </view>
    <view class="field-block">
      <view class="field-header"><text>一句话介绍</text><text>{{profile.bio.length}}/60</text></view>
      <textarea class="bio-input" maxlength="60" value="{{profile.bio}}" placeholder="例如：想认识一起跑步的朋友" bindinput="inputBio" />
    </view>
  </view>

  <view class="card form-card">
    <view class="field-header"><text class="section-title compact-title">兴趣标签</text><text>{{profile.tags.length}}/3</text></view>
    <text class="field-tip">最多选择 3 个，更方便找到聊得来的伙伴</text>
    <view class="tag-options">
      <view
        wx:for="{{tagOptions}}"
        wx:key="label"
        class="tag-option {{item.selected ? 'selected' : ''}}"
        data-tag="{{item.label}}"
        bindtap="toggleTag"
      >{{item.label}}</view>
    </view>
    <view class="custom-tag-row">
      <input class="custom-tag-input" maxlength="8" value="{{customTag}}" placeholder="自定义标签" bindinput="inputCustomTag" bindconfirm="addCustomTag" />
      <button class="add-tag-btn" bindtap="addCustomTag">添加</button>
    </view>
    <view wx:if="{{profile.tags.length}}" class="selected-tags">
      <view wx:for="{{profile.tags}}" wx:key="*this" class="selected-tag" data-tag="{{item}}" bindtap="toggleTag">{{item}} ×</view>
    </view>
  </view>

  <view class="card form-card">
    <view class="section-title">当前社交意愿</view>
    <view
      wx:for="{{intentions}}"
      wx:key="value"
      class="intention-option {{profile.intention === item.value ? 'selected' : ''}}"
      data-value="{{item.value}}"
      bindtap="selectIntention"
    >
      <view>
        <text class="intention-label">{{item.label}}</text>
        <text class="intention-description">{{item.description}}</text>
      </view>
      <text class="radio-dot">{{profile.intention === item.value ? '●' : '○'}}</text>
    </view>
  </view>

  <view class="card form-card private-contact-card">
    <view class="field-header">
      <text class="section-title compact-title">私密分享资料</text>
      <text>{{profile.contactOptions.length}}/8</text>
    </view>
    <text class="field-tip">这些预设只保存在本机，不会随名片上传云端。双方同意后，你仍需主动选择要分享的条目。</text>
    <view class="contact-add-row">
      <button data-type="wechat" bindtap="addContactOption">＋ 微信号</button>
      <button data-type="phone" bindtap="addContactOption">＋ 手机号</button>
      <button data-type="qr" bindtap="addContactOption">＋ 二维码</button>
    </view>
    <view wx:if="{{!profile.contactOptions.length}}" class="contact-empty">暂未保存分享资料，可在需要时再添加</view>
    <view wx:for="{{profile.contactOptions}}" wx:key="id" class="contact-option-editor">
      <view class="contact-option-head">
        <text>{{item.type === 'wechat' ? '微信号' : (item.type === 'phone' ? '手机号' : '二维码')}}</text>
        <button data-index="{{index}}" bindtap="removeContactOption">删除</button>
      </view>
      <input class="text-input contact-label-input" maxlength="12" value="{{item.label}}" placeholder="名称，例如：常用微信" data-index="{{index}}" data-field="label" bindinput="inputContactOption" />
      <input wx:if="{{item.type !== 'qr'}}" class="text-input contact-value-input" maxlength="{{item.type === 'wechat' ? 32 : 20}}" value="{{item.value}}" placeholder="{{item.type === 'wechat' ? '填写微信号' : '填写手机号'}}" data-index="{{index}}" data-field="value" bindinput="inputContactOption" />
      <view wx:else class="contact-qr-editor">
        <image wx:if="{{item.localPath || item.qrCodeFileId}}" src="{{item.localPath || item.qrCodeFileId}}" mode="aspectFill" data-index="{{index}}" bindtap="previewContactQr" />
        <view wx:else class="contact-qr-placeholder">二维码</view>
        <button data-index="{{index}}" bindtap="chooseContactQr">{{item.localPath || item.qrCodeFileId ? '更换图片' : '选择图片'}}</button>
      </view>
    </view>
  </view>

  <button class="primary-btn save-btn" loading="{{saving}}" disabled="{{saving}}" bindtap="saveProfile">{{saving ? '正在保存' : '保存社交名片'}}</button>

  <view class="preview-title">别人将看到的名片</view>
  <view class="card profile-preview">
    <image wx:if="{{profile.avatarType === 'custom'}}" class="preview-avatar" src="{{profile.avatarValue}}" mode="aspectFill" />
    <view wx:else class="preview-avatar virtual-avatar" style="background: {{profile.avatarColor}}">{{profile.avatarValue}}</view>
    <view class="preview-main">
      <view class="preview-name-row">
        <text class="preview-name">{{profile.nickname || '云团朋友'}}</text>
        <text class="intention-badge">{{intentionLabel}}</text>
      </view>
      <text class="preview-bio">{{profile.bio || '很高兴在云团遇见你'}}</text>
      <view wx:if="{{profile.tags.length}}" class="preview-tags">
        <text wx:for="{{profile.tags}}" wx:key="*this">{{item}}</text>
      </view>
      <text wx:else class="preview-empty-tags">还没有选择兴趣标签</text>
      <text class="preview-privacy-tip">对方只能在真实相遇后向你打招呼</text>
    </view>
  </view>
</view>
