.partners-page { padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }
.page-heading { margin: 10rpx 4rpx 30rpx; }

.ai-companion-card, .encounter-entry { display: flex; min-height: 132rpx; align-items: center; gap: 22rpx; padding: 28rpx 30rpx; box-sizing: border-box; transition: transform 140ms cubic-bezier(.2,.8,.2,1); }
.ai-companion-card { min-height: 156rpx; border: 2rpx solid rgba(71, 119, 103, .18); background: linear-gradient(135deg, #e4f1e9, #f8fcf9); box-shadow: 0 12rpx 30rpx rgba(61, 105, 91, .11); }
.encounter-entry { background: #fffaf0; }
.ai-companion-card:active, .encounter-entry:active { transform: scale(.985); }
.ai-companion-avatar, .encounter-entry-icon { width: 96rpx; height: 96rpx; flex: 0 0 96rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 40rpx; font-weight: 700; }
.ai-companion-avatar { background: #d7e9df; color: #315f52; font-size: 32rpx; letter-spacing: 1rpx; }
.ai-chat-title { display: block; color: #263f37; font-size: 36rpx; font-weight: 750; }
.ai-chat-button { display: flex; min-width: 156rpx; min-height: 76rpx; flex: none; align-items: center; justify-content: center; padding: 0 22rpx; box-sizing: border-box; border-radius: 20rpx; background: #52796f; color: #fff; font-size: 29rpx; font-weight: 700; }
.encounter-entry-icon { background: #f5e7c6; color: #866629; }
.ai-entry-arrow { flex: none; color: #7c8d86; font-size: 52rpx; }
.encounter-entry-title-row { display: flex; align-items: center; gap: 12rpx; }
.encounter-entry-title { font-size: 34rpx; font-weight: 700; }
.encounter-entry-count { padding: 5rpx 12rpx; border-radius: 999rpx; background: #f2ead7; color: #755d31; font-size: 25rpx; }

.conversation-list { padding: 0 30rpx; }
.list-section-head { display: flex; min-height: 104rpx; align-items: center; justify-content: space-between; transition: transform 140ms cubic-bezier(.2,.8,.2,1); }
.list-section-head:active { transform: scale(.99); }
.section-title-wrap { display: flex; align-items: center; gap: 13rpx; }
.list-section-title { color: #2e443c; font-size: 33rpx; font-weight: 700; }
.section-count { display: flex; min-width: 42rpx; height: 42rpx; align-items: center; justify-content: center; padding: 0 10rpx; box-sizing: border-box; border-radius: 21rpx; background: #e8f0eb; color: #496d62; font-size: 24rpx; }
.section-toggle { color: #718079; font-size: 26rpx; }
.greeting-section-head { border-top: 1rpx solid #e4ebe6; }
.section-notice-dot { margin-left: 1rpx; }

.conversation-row { display: flex; align-items: center; gap: 20rpx; min-height: 148rpx; border-bottom: 1rpx solid #e7ece9; transition: transform 140ms cubic-bezier(.2,.8,.2,1); }
.conversation-row:active { transform: scale(.985); }
.conversation-avatar { width: 94rpx; height: 94rpx; flex: 0 0 94rpx; border-radius: 50%; }
.virtual-avatar { display: flex; align-items: center; justify-content: center; font-size: 40rpx; }
.conversation-main { flex: 1; min-width: 0; }
.conversation-title-row { display: flex; align-items: center; justify-content: space-between; gap: 15rpx; }
.conversation-name { overflow: hidden; font-size: 33rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.conversation-time { flex: none; color: #7f8b86; font-size: 25rpx; }
.conversation-summary { display: block; overflow: hidden; margin-top: 9rpx; color: #61716a; font-size: 28rpx; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.accepted-summary { color: #3f7263; }
.notice-dot { width: 18rpx; height: 18rpx; flex: 0 0 18rpx; border-radius: 50%; background: #d84f45; }
.inline-empty { padding: 26rpx 0 38rpx; color: #78867f; font-size: 28rpx; text-align: center; }
.greeting-empty { padding-bottom: 32rpx; }
.greeting-row { min-height: 210rpx; align-items: flex-start; padding: 28rpx 0; box-sizing: border-box; }
.greeting-row:last-of-type { border-bottom: 0; }
.greeting-summary { white-space: normal; }
.greeting-actions { display: flex; gap: 14rpx; margin-top: 20rpx; }
.greeting-actions button { width: auto; min-height: 76rpx; margin: 0; padding: 0 24rpx; border-radius: 18rpx; background: #edf1ee !important; color: #52635c !important; font-size: 28rpx; line-height: 76rpx; }
.greeting-actions .accept-greeting { background: #52796f !important; color: #fff !important; }
.greeting-actions button::after { border: 0; }
.load-more-button { width: 100%; min-height: 84rpx; margin: 10rpx 0 26rpx; border: 0; border-radius: 20rpx; background: #edf3ef !important; color: #426f62 !important; font-size: 29rpx; line-height: 84rpx; }
.load-more-button::after { border: 0; }

.blocked-manager { margin-top: 28rpx; }
.blocked-toggle { display: flex; min-height: 88rpx; align-items: center; justify-content: space-between; padding: 0 8rpx; color: #68766f; font-size: 28rpx; transition: transform 140ms cubic-bezier(.2,.8,.2,1); }
.blocked-toggle:active { transform: scale(.985); }
.blocked-card { padding: 30rpx; }
.blocked-name { color: #61716a; font-size: 31rpx; }
.blocked-footer { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 20rpx; }
.time { color: #718079; font-size: 26rpx; }
.blocked-footer button { width: auto; min-height: 76rpx; margin: 0; padding: 0 24rpx; border-radius: 18rpx; background: #edf1ee !important; color: #426f62 !important; font-size: 28rpx; line-height: 76rpx; }
.blocked-footer button::after { border: 0; }
