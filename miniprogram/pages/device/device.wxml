<view class="page device-page tab-swipe-page" style="{{tabSwipeStyle}}" bindtouchstart="onTabSwipeStart" bindtouchmove="onTabSwipeMove" bindtouchend="onTabSwipeEnd" bindtouchcancel="onTabSwipeCancel">
  <view class="page-heading">
    <view>
      <view class="title">我的挂件</view>
    </view>
    <view class="device-state-pill {{device.ready ? 'online' : ''}}">
      <text class="state-dot"></text>
      <text>{{device.ready ? '已连接' : '未连接'}}</text>
    </view>
  </view>

  <view class="card device-summary-card">
    <view class="owner-row">
      <image wx:if="{{socialProfile.avatarType === 'custom'}}" class="device-owner-avatar" src="{{socialProfile.avatarValue}}" mode="aspectFill" />
      <view wx:else class="device-owner-avatar virtual-owner-avatar" style="background: {{socialProfile.avatarColor}}">{{socialProfile.avatarValue}}</view>
      <view class="owner-copy">
        <text class="owner-nickname">{{socialProfile.nickname}}</text>
      </view>
      <button class="profile-edit-button" data-no-swipe="true" aria-label="编辑个人名片" bindtap="goSocialProfile">编辑</button>
    </view>

    <view class="profile-meta">
      <text wx:for="{{socialProfile.tags}}" wx:key="*this" class="profile-tag">{{item}}</text>
    </view>

    <view class="device-status-row">
      <view class="connection-line {{device.ready ? 'connected' : ''}}">
        {{device.ready ? (device.simulated ? '模拟挂件已就绪' : '云团挂件已就绪') : (device.connected ? '正在初始化设备…' : statusText)}}
      </view>
      <text wx:if="{{device.ready && device.battery !== null}}" class="battery-number">约 {{device.battery}}%</text>
      <text wx:elif="{{device.ready}}" class="battery-state-text {{device.batteryStatus === 'unavailable' ? 'unavailable' : ''}}">
        {{device.batteryStatus === 'unavailable' ? '电量暂不可用' : '电量读取中…'}}
      </text>
    </view>
    <view wx:if="{{device.ready && device.battery !== null}}" class="battery-wrap">
      <view class="battery-fill" style="width: {{device.battery}}%"></view>
    </view>
    <text wx:if="{{device.battery !== null && device.battery <= 20}}" class="low-battery">电量较低，请及时充电</text>
    <text wx:if="{{device.errorMessage}}" class="error-text">{{device.errorMessage}}</text>
  </view>

  <block wx:if="{{!device.connected}}">
    <view class="connection-actions">
      <button
        wx:if="{{device.canReconnect}}"
        class="primary-btn {{device.reconnecting ? 'cancel-reconnect-btn' : ''}}"
        data-no-swipe="true"
        disabled="{{operating && !device.reconnecting}}"
        bindtap="reconnectLastDevice"
      >{{device.reconnecting ? '停止重新连接' : ('重新连接 ' + (device.rememberedDeviceName || '上次的挂件'))}}</button>
      <button wx:if="{{!discovering}}" class="primary-btn" disabled="{{operating || device.reconnecting}}" bindtap="startScan">搜索附近挂件</button>
      <button wx:else class="secondary-btn" bindtap="stopScan">停止搜索</button>
    </view>

    <view wx:if="{{discovering || nearbyDevices.length}}" class="section-head">
      <text>附近挂件</text><text>{{nearbyDevices.length}} 台</text>
    </view>
    <view wx:if="{{discovering && !nearbyDevices.length}}" class="empty compact-empty">正在搜索，请把挂件放在手机附近…</view>
    <view wx:for="{{nearbyDevices}}" wx:key="deviceId" class="nearby-device card">
      <view class="nearby-info">
        <text class="nearby-name">{{item.name}}</text>
        <text class="nearby-hint">附近的云团挂件</text>
      </view>
      <button class="connect-btn" loading="{{connectingDeviceId === item.deviceId}}" disabled="{{operating}}" data-device-id="{{item.deviceId}}" bindtap="connectDevice">连接</button>
    </view>
  </block>

  <view wx:if="{{device.ready}}" class="card quick-actions-card">
    <view class="device-action-row">
      <button class="find-device-button" disabled="{{operating}}" data-no-swipe="true" bindtap="findDevice">提醒查找挂件</button>
      <button class="disconnect-device-button" disabled="{{operating}}" data-no-swipe="true" bindtap="disconnectDevice">断开连接</button>
    </view>
  </view>

  <view class="card more-entry" bindtap="goMore">
    <view class="more-entry-icon"><view class="more-dot"></view><view class="more-dot"></view><view class="more-dot"></view></view>
    <text class="more-entry-title">更多</text>
    <text class="entry-arrow">›</text>
  </view>
</view>
