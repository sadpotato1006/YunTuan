<view class="page device-page tab-swipe-page" style="{{tabSwipeStyle}}" bindtouchstart="onTabSwipeStart" bindtouchmove="onTabSwipeMove" bindtouchend="onTabSwipeEnd" bindtouchcancel="onTabSwipeCancel">
  <view class="page-heading">
    <view>
      <view class="title">我的挂件</view>
      <text class="page-subtitle">连接设备、管理提醒并查看最近相遇</text>
    </view>
    <view class="device-state-pill {{device.ready ? 'online' : ''}}">
      <text class="state-dot"></text>
      <text>{{device.ready ? '已连接' : '未连接'}}</text>
    </view>
  </view>

  <view class="card device-summary-card">
    <view class="owner-row">
      <image wx:if="{{socialProfile.avatarType === 'custom'}}" class="device-owner-avatar" src="{{socialProfile.avatarValue}}" mode="aspectFill" />
      <view wx:else class="device-owner-avatar virtual-owner-avatar" style="background: {{socialProfile.avatarColor}}">{{socialProfile.avatarValue}}</view>
      <view class="owner-copy">
        <text class="owner-nickname">{{socialProfile.nickname}}</text>
        <text class="device-name">{{device.name}}</text>
      </view>
      <view wx:if="{{device.ready && device.battery !== null}}" class="battery-summary">
        <text class="battery-number">{{device.battery}}%</text>
        <text wx:if="{{device.chargingState === 1}}" class="charging-badge">充电中</text>
        <text wx:elif="{{device.chargingState === 2}}" class="charging-badge full">已充满</text>
      </view>
    </view>
    <view class="connection-line {{device.ready ? 'connected' : ''}}">
      {{device.ready ? (device.simulated ? '模拟挂件已就绪' : '云团挂件已就绪') : (device.connected ? '正在初始化设备…' : statusText)}}
    </view>
    <view wx:if="{{device.ready && device.battery !== null}}" class="battery-wrap">
      <view class="battery-fill" style="width: {{device.battery}}%"></view>
    </view>
    <text wx:if="{{device.battery !== null && device.battery <= 20 && device.chargingState !== 1 && device.chargingState !== 2}}" class="low-battery">电量较低，请及时充电</text>
    <text wx:if="{{device.errorMessage}}" class="error-text">{{device.errorMessage}}</text>
  </view>

  <block wx:if="{{!device.connected}}">
    <view class="connection-actions">
      <button
        wx:if="{{device.canReconnect}}"
        class="primary-btn"
        loading="{{device.connecting}}"
        disabled="{{operating || device.connecting}}"
        bindtap="reconnectLastDevice"
      >重新连接 {{device.rememberedDeviceName || '上次的挂件'}}</button>
      <button wx:if="{{!discovering}}" class="primary-btn" disabled="{{operating}}" bindtap="startScan">搜索附近挂件</button>
      <button wx:else class="secondary-btn" bindtap="stopScan">停止搜索</button>
      <view class="device-details-entry" bindtap="goDeviceDetails">
        <view><text>设备详细信息</text><text>连接信息、模拟设备与 BLE 联调</text></view>
        <text class="entry-arrow">›</text>
      </view>
    </view>

    <view wx:if="{{discovering || nearbyDevices.length}}" class="section-head">
      <text>附近挂件</text><text>{{nearbyDevices.length}} 台</text>
    </view>
    <view wx:if="{{discovering && !nearbyDevices.length}}" class="empty compact-empty">正在搜索，请把挂件放在手机附近…</view>
    <view wx:for="{{nearbyDevices}}" wx:key="deviceId" class="nearby-device card">
      <view class="nearby-info">
        <text class="nearby-name">{{item.name}}</text>
        <text class="nearby-id">设备 ID：{{item.name}}</text>
        <text class="nearby-rssi">信号 {{item.RSSI}} dBm</text>
      </view>
      <button class="connect-btn" loading="{{connectingDeviceId === item.deviceId}}" disabled="{{operating}}" data-device-id="{{item.deviceId}}" bindtap="connectDevice">连接</button>
    </view>
  </block>

  <block wx:if="{{device.ready}}">
    <view class="section-head"><text>常用功能</text></view>
    <view class="card core-controls-card">
      <view class="setting-row">
        <view><text class="control-title">社交模式</text><text class="control-tip">开启后才会发现附近的云团伙伴</text></view>
        <switch checked="{{device.socialMode}}" disabled="{{operating}}" color="#52796F" data-no-swipe="true" bindchange="toggleSocialMode" />
      </view>
      <view class="setting-row compact-setting-row">
        <view><text class="control-title">社交提醒</text><text class="control-tip">遇到附近伙伴时提醒</text></view>
        <switch checked="{{settings.socialReminder}}" disabled="{{settingSaving}}" color="#52796F" data-key="socialReminder" data-no-swipe="true" bindchange="updateAlertSetting" />
      </view>
      <view class="setting-row compact-setting-row">
        <view><text class="control-title">振动反馈</text><text class="control-tip">挂件提醒时使用振动</text></view>
        <switch checked="{{settings.vibration}}" disabled="{{settingSaving}}" color="#52796F" data-key="vibration" data-no-swipe="true" bindchange="updateAlertSetting" />
      </view>
      <view class="setting-row compact-setting-row">
        <view><text class="control-title">声音提示</text><text class="control-tip">挂件提醒时播放提示音</text></view>
        <switch checked="{{settings.sound}}" disabled="{{settingSaving}}" color="#52796F" data-key="sound" data-no-swipe="true" bindchange="updateAlertSetting" />
      </view>
      <button class="find-device-button" disabled="{{operating}}" bindtap="findDevice">提醒查找挂件</button>
    </view>

    <view class="section-head encounter-section-head">
      <text>最近相遇</text>
      <text class="section-link" bindtap="goEncounters">全部记录{{device.encounterCount ? ' · ' + device.encounterCount : ''}} ›</text>
    </view>
    <view wx:if="{{device.lastEncounterAt}}" class="card encounter-card">
      <block wx:if="{{device.lastEncounterProfile}}">
        <view class="encounter-profile-row">
          <image wx:if="{{device.lastEncounterProfile.avatarType === 'custom'}}" class="encounter-avatar" src="{{device.lastEncounterProfile.avatarValue}}" mode="aspectFill" />
          <view wx:else class="encounter-avatar virtual-encounter-avatar" style="background: {{device.lastEncounterProfile.avatarColor}}">{{device.lastEncounterProfile.avatarValue}}</view>
          <view class="encounter-content">
            <view class="encounter-name-row">
              <text class="encounter-name">{{device.lastEncounterProfile.nickname}}</text>
              <text class="encounter-intention">{{device.lastEncounterProfile.intentionLabel}}</text>
            </view>
            <text class="encounter-bio">{{device.lastEncounterProfile.bio}}</text>
            <view wx:if="{{device.lastEncounterProfile.tags.length}}" class="encounter-tags">
              <text wx:for="{{device.lastEncounterProfile.tags}}" wx:key="*this">{{item}}</text>
            </view>
          </view>
        </view>
        <text class="encounter-meta">{{device.lastEncounterText}} · 信号 {{device.lastEncounterRssi}} dBm</text>
        <view class="encounter-actions">
          <button
            wx:if="{{latestEncounter.interactionRef && latestEncounter.greetingStatus === 'none' && device.lastEncounterProfile.intention !== 'quiet'}}"
            class="greet-button"
            loading="{{operating}}"
            disabled="{{operating}}"
            bindtap="greetLatestEncounter"
          >打个招呼</button>
          <view wx:elif="{{latestEncounter.greetingStatus === 'sent'}}" class="greeting-state">招呼已发送，等待回应</view>
          <view wx:elif="{{latestEncounter.greetingStatus === 'matched'}}" class="greeting-state matched" bindtap="goSocialInbox">已经认识 · 去聊天 ›</view>
          <button class="view-encounters-button" bindtap="goEncounters">查看详情</button>
        </view>
      </block>
      <block wx:else>
        <view class="encounter-loading-row">
          <view class="encounter-icon">遇</view>
          <view class="encounter-content">
            <text class="control-title">遇到一位云团伙伴</text>
            <text class="control-tip">{{device.encounterProfileLoading ? '正在获取对方的公开名片…' : device.encounterProfileMessage}}</text>
          </view>
        </view>
        <button wx:if="{{!device.encounterProfileLoading}}" class="encounter-retry" bindtap="retryEncounterProfile">重新获取名片</button>
      </block>
    </view>
    <view wx:else class="empty card compact-empty">开启社交模式后，最近遇见的伙伴会显示在这里</view>

    <view class="section-head"><text>更多</text></view>
    <view class="card device-details-entry connected-entry" bindtap="goDeviceDetails">
      <view><text>设备详细信息</text><text>型号、版本、连接管理与开发测试</text></view>
      <text class="entry-arrow">›</text>
    </view>
  </block>
</view>
