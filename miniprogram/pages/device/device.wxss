.device-page { padding-bottom: calc(72rpx + env(safe-area-inset-bottom)); }
.page-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; margin: 10rpx 4rpx 32rpx; }
.device-state-pill { display: flex; align-items: center; gap: 10rpx; flex: none; margin-top: 10rpx; padding: 13rpx 20rpx; border-radius: 999rpx; background: #ecefed; color: #6f7b76; font-size: 28rpx; }
.device-state-pill.online { background: #e2efe7; color: #356858; }
.state-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #929c98; }
.online .state-dot { background: #4f9665; }

.device-summary-card { padding: 34rpx; }
.owner-row { display: flex; align-items: center; gap: 22rpx; }
.device-owner-avatar { width: 96rpx; height: 96rpx; flex: 0 0 96rpx; border-radius: 50%; }
.virtual-owner-avatar { display: flex; align-items: center; justify-content: center; font-size: 44rpx; }
.owner-copy { flex: 1; min-width: 0; }
.owner-nickname { display: block; overflow: hidden; font-size: 40rpx; font-weight: 700; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.profile-edit-button { width: 120rpx; min-width: 120rpx; height: 72rpx; min-height: 72rpx; flex: 0 0 120rpx; margin: 0 0 0 auto; padding: 0; border: 1rpx solid rgba(77, 126, 112, .22); border-radius: 36rpx; background: #edf4f0 !important; color: #3e6f60 !important; font-size: 27rpx; font-weight: 700; line-height: 70rpx; transition: transform 140ms cubic-bezier(.2,.8,.2,1), background-color 160ms ease-out; }
.profile-edit-button::after { border: 0; }
.profile-edit-button:active { background: #e1ede7 !important; transform: scale(.97); }
.profile-meta { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 22rpx; }
.profile-tag { padding: 10rpx 18rpx; border-radius: 999rpx; background: #f5f2e9; color: #6f6449; font-size: 27rpx; line-height: 1.4; }
.device-status-row { display: flex; align-items: center; justify-content: space-between; gap: 22rpx; margin-top: 28rpx; }
.battery-number { flex: none; color: #426f63; font-size: 31rpx; font-weight: 700; }
.battery-state-text { flex: none; color: #68766f; font-size: 28rpx; font-weight: 650; }
.battery-state-text.unavailable { color: #9a655d; }
.connection-line { color: #75817c; font-size: 29rpx; }
.connection-line.connected { color: #426f63; }
.battery-wrap { height: 16rpx; margin-top: 18rpx; overflow: hidden; border-radius: 999rpx; background: #e4e9e6; }
.battery-fill { height: 100%; border-radius: 999rpx; background: #6f9e77; }
.low-battery, .error-text { display: block; margin-top: 15rpx; color: #ad5146; font-size: 28rpx; line-height: 1.5; }

.connection-actions { display: flex; flex-direction: column; gap: 18rpx; }
.connection-actions button { width: 100%; margin: 0; }
.cancel-reconnect-btn { background: #806b62 !important; }
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin: 44rpx 4rpx 18rpx; }
.section-head > text:first-child { font-size: 36rpx; font-weight: 700; }
.section-head > text:last-child { color: #74807b; font-size: 28rpx; }
.compact-empty { padding: 48rpx 22rpx; font-size: 29rpx; line-height: 1.55; }
.nearby-device { display: flex; align-items: center; gap: 22rpx; padding: 30rpx; }
.nearby-info { flex: 1; min-width: 0; }
.nearby-name, .nearby-hint { display: block; }
.nearby-name { font-size: 34rpx; font-weight: 700; }
.nearby-hint { margin-top: 9rpx; color: #6f7d77; font-size: 28rpx; }
.connect-btn { width: 150rpx; min-width: 0; min-height: 84rpx; flex: 0 0 150rpx; margin: 0; padding: 0; border-radius: 20rpx; background: #52796f !important; color: #fff !important; font-size: 31rpx; line-height: 84rpx; }
.connect-btn::after { border: 0; }

.quick-actions-card { padding: 28rpx; }
.device-action-row { display: flex; gap: 18rpx; }
.device-action-row button { width: auto; min-width: 0; min-height: 96rpx; flex: 1 1 0; margin: 0; padding: 0 14rpx; border-radius: 22rpx; font-size: 29rpx; font-weight: 700; line-height: 96rpx; }
.find-device-button { background: #e4eee8 !important; color: #315f52 !important; }
.disconnect-device-button { background: #f3e9e6 !important; color: #8b4e46 !important; }
.find-device-button::after, .disconnect-device-button::after { border: 0; }

.more-entry { display: flex; min-height: 116rpx; align-items: center; gap: 22rpx; padding: 22rpx 30rpx; transition: transform 140ms cubic-bezier(.2,.8,.2,1); }
.more-entry:active { transform: scale(.985); }
.more-entry-icon { display: flex; width: 72rpx; height: 72rpx; flex: 0 0 72rpx; align-items: center; justify-content: center; gap: 6rpx; border-radius: 50%; background: #e9f0ec; }
.more-dot { width: 8rpx; height: 8rpx; flex: 0 0 8rpx; border-radius: 50%; background: #426f62; }
.more-entry-title { flex: 1; font-size: 34rpx; font-weight: 700; }
.entry-arrow { flex: none; color: #89948f; font-size: 48rpx; }

.find-device-button, .disconnect-device-button, .connect-btn { transition: transform 140ms cubic-bezier(.2,.8,.2,1), background-color 160ms ease-out; }
.find-device-button:active, .disconnect-device-button:active, .connect-btn:active { transform: scale(.97); }
