.hero { padding-top: 44rpx; background: linear-gradient(145deg, #edf4ed, #fffaf0); }
.eyebrow { color: #52796f; font-size: 28rpx; letter-spacing: 4rpx; }
.title { margin-top: 16rpx; }
.device-row { display: flex; align-items: center; margin-top: 36rpx; color: #60706b; font-size: 29rpx; }
.status-dot { width: 18rpx; height: 18rpx; border-radius: 50%; background: #aaa; margin-right: 12rpx; }
.status-dot.online { background: #65a76f; }
.battery { margin-left: auto; }
.row-arrow { margin-left: 12rpx; color: #97a19d; font-size: 40rpx; line-height: 1; }
.chat-btn { margin: 32rpx 0; }
.care-card { border-left: 8rpx solid #e6b566; }
.care-text { line-height: 1.8; color: #52625d; }
.mood-card { display: flex; align-items: center; justify-content: space-between; }
.mood-card > view:first-child { flex: 1; padding-right: 24rpx; }
.mood-card .section-title { margin-bottom: 8rpx; }
.mood-card .muted { font-size: 27rpx; line-height: 1.55; }
.mood-summary { flex-shrink: 0; display: flex; align-items: center; gap: 10rpx; color: #52796f; font-size: 32rpx; font-weight: 600; }
.mood-icon { font-size: 40rpx; }
.hero, .chat-btn, .mood-card { transition: transform 140ms cubic-bezier(.23, 1, .32, 1); }
.device-row:active, .chat-btn:active, .mood-card:active { transform: scale(.98); }
