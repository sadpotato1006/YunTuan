<view class="page">
  <view class="title settings-title">陪伴设置</view>
  <view class="card list-card">
    <view class="setting-item"><view><view>社交提醒</view><text>有人想和您互动时提醒</text></view><switch checked="{{settings.socialReminder}}" color="#52796F" data-key="socialReminder" bindchange="updateSetting" /></view>
    <view class="setting-item"><view><view>振动反馈</view><text>重要操作时轻微振动</text></view><switch checked="{{settings.vibration}}" color="#52796F" data-key="vibration" bindchange="updateSetting" /></view>
    <view class="setting-item"><view><view>声音提示</view><text>播放操作和关怀提示音</text></view><switch checked="{{settings.sound}}" color="#52796F" data-key="sound" bindchange="updateSetting" /></view>
  </view>
  <view class="card list-card links">
    <view class="link-item" bindtap="showPrivacy"><text>隐私设置</text><text class="arrow">›</text></view>
    <view class="link-item" bindtap="showAbout"><text>关于云团</text><text class="arrow">›</text></view>
  </view>
  <view class="version">云团 · 温暖常伴左右</view>
</view>
