<view class="page settings-page tab-swipe-page" style="{{tabSwipeStyle}}" bindtouchstart="onTabSwipeStart" bindtouchmove="onTabSwipeMove" bindtouchend="onTabSwipeEnd" bindtouchcancel="onTabSwipeCancel">
  <view class="profile-heading">
    <text class="title">个人中心</text>
    <text>管理公开名片、隐私与个人数据</text>
  </view>

  <view class="card social-profile-entry" bindtap="goSocialProfile">
    <image wx:if="{{socialProfile.avatarType === 'custom'}}" class="profile-entry-avatar" src="{{socialProfile.avatarValue}}" mode="aspectFill" />
    <view wx:else class="profile-entry-avatar virtual-profile-avatar" style="background: {{socialProfile.avatarColor}}">{{socialProfile.avatarValue}}</view>
    <view class="profile-entry-content">
      <view class="profile-entry-name-row"><text class="profile-entry-name">{{socialProfile.nickname}}</text><text class="profile-entry-intention">{{socialProfile.intentionLabel}}</text></view>
      <text class="profile-entry-bio">{{socialProfile.bio}}</text>
      <text class="profile-edit-hint">查看并编辑我的社交名片</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <view class="settings-section-head"><text>隐私与数据</text></view>
  <view class="card list-card links">
    <view class="link-item" bindtap="showPrivacy"><view><text>隐私说明</text><text>了解聊天、名片和相遇数据如何使用</text></view><text class="arrow">›</text></view>
    <view class="link-item" bindtap="clearLocalData"><view><text>清除本机缓存</text><text>会同时删除本机联系方式预设</text></view><text class="arrow">›</text></view>
    <view class="link-item danger-link" bindtap="deleteCloudData"><view><text>{{deletingCloudData ? '正在删除云端数据…' : '删除全部个人数据'}}</text><text>同时删除云端数据与本机缓存</text></view><text class="arrow">›</text></view>
  </view>

  <view class="settings-section-head"><text>关于</text></view>
  <view class="card list-card links">
    <view class="link-item" bindtap="showAbout"><view><text>关于云团</text><text>产品说明与当前版本</text></view><text class="arrow">›</text></view>
  </view>
  <view class="version">云团 · 温暖常伴左右</view>
</view>
