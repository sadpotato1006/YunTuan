.settings-page { padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }
.profile-heading { margin: 8rpx 4rpx 26rpx; }
.profile-heading > text:last-child { display: block; margin-top: 8rpx; color: #71807b; font-size: 24rpx; }
.social-profile-entry { display: flex; align-items: center; gap: 20rpx; padding: 28rpx; }
.profile-entry-avatar { width: 90rpx; height: 90rpx; flex: 0 0 90rpx; border-radius: 50%; }
.virtual-profile-avatar { display: flex; align-items: center; justify-content: center; font-size: 42rpx; }
.profile-entry-content { flex: 1; min-width: 0; }
.profile-entry-name-row { display: flex; align-items: center; flex-wrap: wrap; gap: 11rpx; }
.profile-entry-name { font-size: 31rpx; font-weight: 650; }
.profile-entry-intention { padding: 5rpx 11rpx; border-radius: 15rpx; background: #e4efe8; color: #52796f; font-size: 20rpx; }
.profile-entry-bio { display: block; overflow: hidden; margin-top: 8rpx; color: #687771; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.profile-edit-hint { display: block; margin-top: 11rpx; color: #52796f; font-size: 22rpx; }
.arrow { flex: none; color: #99a39f; font-size: 46rpx; }
.settings-section-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin: 38rpx 4rpx 15rpx; }
.settings-section-head > text:first-child { font-size: 30rpx; font-weight: 650; }
.list-card { padding: 0 28rpx; }
.link-item { min-height: 116rpx; display: flex; align-items: center; justify-content: space-between; gap: 22rpx; border-bottom: 1rpx solid #edf0ed; }
.link-item:last-child { border-bottom: 0; }
.link-item > view { flex: 1; min-width: 0; }
.link-item view > text:first-child { display: block; font-size: 27rpx; }
.link-item view > text:last-child { display: block; margin-top: 6rpx; color: #7b8883; font-size: 21rpx; line-height: 1.45; }
.danger-link > view > text:first-child { color: #b85f51; }
.version { margin-top: 42rpx; color: #929c98; font-size: 24rpx; text-align: center; }
.social-profile-entry, .link-item { transition: transform 140ms cubic-bezier(.23, 1, .32, 1); }
.social-profile-entry:active, .link-item:active { transform: scale(.98); }
