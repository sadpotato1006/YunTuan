.page { width: 100%; max-width: 100vw; overflow-x: hidden; padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.header { margin: 12rpx 4rpx 36rpx; }
.header .muted { display: block; margin-top: 12rpx; font-size: 28rpx; }
.checkin-btn { width: 100%; min-height: 92rpx; margin: 0 0 24rpx; box-sizing: border-box; border-radius: 20rpx; background: #52796f !important; color: #fff !important; font-size: 33rpx; }
.checkin-btn::after { border: 0; }
.checkin-card { width: 100%; min-width: 0; box-sizing: border-box; padding-bottom: 24rpx; overflow: hidden; }
.checkin-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.checkin-header .section-title { margin-bottom: 0; }
.collapse-btn { flex: none; padding: 10rpx 18rpx; border-radius: 999rpx; background: #edf3ee; color: #52796f; font-size: 25rpx; line-height: 1.2; }
.emotion-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; width: 100%; min-width: 0; }
.emotion-option { width: 100%; min-width: 0; min-height: 118rpx; margin: 0; padding: 14rpx 8rpx; box-sizing: border-box; border-radius: 18rpx; background: #edf3ee !important; color: #425b54 !important; font-size: 29rpx; display: flex; align-items: center; justify-content: center; white-space: nowrap; }
.emotion-option.selected { background: #dcebe3 !important; color: #2f5f51 !important; box-shadow: inset 0 0 0 3rpx #6f9a8b; }
.option-icon { font-size: 42rpx; margin-right: 12rpx; }
.note-field { position: relative; width: 100%; min-width: 0; margin-top: 24rpx; text-align: left; }
.note-label { margin-bottom: 12rpx; color: #425b54; font-size: 28rpx; }
.note-label text { margin-left: 10rpx; color: #98a39f; font-size: 24rpx; }
.note-input { display: block; width: 100%; max-width: 100%; height: 180rpx; min-height: 180rpx; box-sizing: border-box; padding: 20rpx 22rpx 42rpx; border-radius: 16rpx; background: #f3f6f3; color: #34443f; font-size: 29rpx; line-height: 1.55; }
.note-count { position: absolute; right: 18rpx; bottom: 14rpx; color: #9aa5a1; font-size: 22rpx; }
.save-emotion-btn { width: 100%; min-height: 86rpx; margin: 22rpx 0 0; box-sizing: border-box; border-radius: 18rpx; background: #52796f !important; color: #fff !important; font-size: 30rpx; }
.save-emotion-btn[disabled] { background: #b5c3be !important; color: #f5f6f5 !important; }
.save-emotion-btn::after { border: 0; }
.checkin-tip { display: block; margin-top: 18rpx; color: #87938f; font-size: 25rpx; line-height: 1.5; }
.record { width: 100%; min-width: 0; box-sizing: border-box; border-left: 8rpx solid #8aafa0; overflow-wrap: anywhere; }
.record.editable { background: #fcfefd; }
.record.editable:active { background: #f3f7f4; }
.record-top { display: flex; justify-content: space-between; color: #71807b; font-size: 28rpx; }
.edit-hint { padding: 6rpx 14rpx; border-radius: 999rpx; background: #edf3ee; color: #52796f; font-size: 24rpx; line-height: 1.2; }
.emotion-name { display: flex; align-items: center; font-size: 38rpx; font-weight: 600; margin: 18rpx 0 12rpx; }
.record-emotion-icon { margin-right: 12rpx; font-size: 38rpx; }
.note { color: #60706b; line-height: 1.6; }
.empty-icon { font-size: 70rpx; color: #8aafa0; }
.empty text { display: block; margin-top: 16rpx; font-size: 28rpx; }
