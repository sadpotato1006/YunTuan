<view class="page">
  <view class="header">
    <view class="title">最近的心情</view>
    <text class="muted">每一种感受，都值得被温柔看见</text>
  </view>

  <button class="checkin-btn" loading="{{saving}}" bindtap="toggleCheckIn">
    {{showCheckIn ? '暂时不记了' : '记录今天的心情'}}
  </button>

  <view wx:if="{{showCheckIn}}" class="checkin-card card">
    <view class="section-title">今天感觉怎么样？</view>
    <view class="emotion-options">
      <button
        wx:for="{{options}}"
        wx:key="name"
        class="emotion-option"
        disabled="{{saving}}"
        data-name="{{item.name}}"
        bindtap="selectEmotion"
      >
        <text class="option-icon">{{item.icon}}</text>
        <text>{{item.name}}</text>
      </button>
    </view>
    <text class="checkin-tip">每天保留一条记录，再次选择会更新今天的心情。</text>
  </view>

  <view wx:if="{{loading}}" class="loading">正在整理情绪记录…</view>
  <view wx:elif="{{records.length === 0}}" class="empty card">
    <view class="empty-icon">♡</view><view>还没有情绪记录</view>
    <text>点击上方按钮，记录今天的感受</text>
  </view>
  <view wx:else>
    <view wx:for="{{records}}" wx:key="id" class="record card">
      <view class="record-top"><text class="date">{{item.date}}</text><text class="score">{{item.score}} 分</text></view>
      <view class="emotion-name">{{item.name}}</view>
      <text class="note">{{item.note}}</text>
    </view>
  </view>
</view>
